{
  "_": "Shared case file: the TypeScript grammar and the vendored Python mirror in vinci-gpu-control BOTH read this, so neither can drift. Refusals for control characters, bidi overrides, edge spaces and wildcards are stated by EXPLICIT CODE POINT, never by trim()/str.strip(), because those two do not agree on what counts as whitespace and the disagreement would be silent. NFC and NFD spellings of one filename remain DISTINCT accepted roots: neither side normalises, so a grant in one spelling does not cover a child in the other (fail-closed).",
  "accepted": [
    {
      "token": "path:src/",
      "root": "src/",
      "kind": "directory"
    },
    {
      "token": "path:src/x.ts",
      "root": "src/x.ts",
      "kind": "file"
    },
    {
      "token": "path:docs/README.md",
      "root": "docs/README.md",
      "kind": "file"
    },
    {
      "token": "path:a/b/c/",
      "root": "a/b/c/",
      "kind": "directory"
    },
    {
      "token": "path:.github/workflows/gate.yml",
      "root": ".github/workflows/gate.yml",
      "kind": "file"
    },
    {
      "token": "path:a..b/",
      "root": "a..b/",
      "kind": "directory"
    },
    {
      "token": "path:src/café/",
      "root": "src/café/",
      "kind": "directory",
      "why": "NFC: e-acute as one code point"
    },
    {
      "token": "path:src/café/",
      "root": "src/café/",
      "kind": "directory",
      "why": "NFD: e + combining acute -- a DISTINCT root from the NFC spelling above; neither side normalises"
    }
  ],
  "refused": [
