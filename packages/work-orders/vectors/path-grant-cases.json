      "reason": "dot_segment"
    },
    {
      "token": "path:..",
      "reason": "dotdot_segment"
    },
    {
      "token": "path:../src/",
      "reason": "dotdot_segment"
    },
    {
      "token": "path:src/..",
      "reason": "dotdot_segment"
    },
    {
