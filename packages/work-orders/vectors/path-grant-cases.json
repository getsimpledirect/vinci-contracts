      "reason": "nul"
    },
    {
      "token": "path:\u0000",
      "reason": "nul"
    },
    {
      "token": "path:src/ ",
      "reason": "edge_space",
      "why": "trailing space is part of the name, not trimmed"
    },
    {
      "token": "path: src/",
      "reason": "edge_space",
      "why": "leading space is part of the name, not trimmed"
    },
    {
      "token": "path:src/\tx",
      "reason": "control_char",
      "why": "TAB inside a segment"
    },
    {
      "token": "path:src/\rx",
      "reason": "control_char",
      "why": "CR inside a segment"
    },
    {
      "token": "path:src/\nx",
      "reason": "control_char",
      "why": "LF inside a segment"
    },
    {
      "token": "path:src/ x",
      "reason": "edge_space",
      "why": "NO-BREAK SPACE is not ASCII space"
    },
    {
      "token": "path:src/x​",
      "reason": "edge_space",
      "why": "ZERO WIDTH SPACE is invisible but significant"
    },
    {
      "token": "path:src/‮evil",
      "reason": "bidi_control",
      "why": "RIGHT-TO-LEFT OVERRIDE renders misleadingly but is one more character"
    },
    {
      "token": "path:src/*",
      "reason": "wildcard",
      "why": "reads as a branch:-style wildcard; here it would be a literal filename"
    },
    {
      "token": "path:*",
      "reason": "wildcard",
      "why": "same, at the root"
    },
    {
      "token": "path:src/**",
      "reason": "wildcard",
      "why": "no glob syntax in this grammar at all"
    }
